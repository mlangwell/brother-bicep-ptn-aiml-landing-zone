# =============================================================================
# AI Guardrails — post-deployment configuration
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored; this example never is.
#
# NOTHING IN THIS FILE IS A SECRET. The script authenticates with your existing
# `az login` context (or a workload identity in CI). Do not add keys, connection
# strings, or SAS tokens here — if you find yourself wanting to, that is a
# design smell, not a config gap.
#
# Values marked REQUIRED have no safe default and the script fails closed
# without them. Values marked OWNED-BY-BICEP are read for verification only;
# the script will never write them (the landing-zone template owns them).
# =============================================================================


# -----------------------------------------------------------------------------
# 0. TARGET — checked before any write. A mismatch aborts the whole run.
# -----------------------------------------------------------------------------
# This is the wrong-subscription / cross-engagement guard. The script compares
# these against the live `az account show` context and refuses to continue if
# either differs. Do not remove them to "make it work".

AZ_TENANT_ID=00000000-0000-0000-0000-000000000000          # REQUIRED
AZ_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000    # REQUIRED
AZ_RESOURCE_GROUP=rg-brother-ailz-dev                      # REQUIRED — the workload RG
AZ_LOCATION=eastus2                                        # REQUIRED

# Free-text, used in resource names and in the evidence file. Keep it to this
# engagement — never carry a name over from another customer.
PROJECT_NAME=brother
ENVIRONMENT=dev

# Must match `governance.assignmentPrefix` in the landing-zone environment JSON
# (environments/<env>.json). The script uses it to find Bicep-owned resources
# so it can verify rather than duplicate them.
ASSIGNMENT_PREFIX=ailz-dev                                 # REQUIRED


# -----------------------------------------------------------------------------
# 1. ACCESS — the custom "innovate but don't spend" role
# -----------------------------------------------------------------------------
# READ THIS BEFORE TUNING ANYTHING BELOW:
#
#   Azure RBAC cannot express "not expensive". A role definition is a list of
#   resource-provider OPERATIONS. It cannot see the SKU, size, capacity or
#   throughput in the request body. Azure Policy is the mechanism that reads
#   resource properties.
#     — https://learn.microsoft.com/azure/governance/policy/overview
#
#   So the guardrail is a PAIR, and both halves must be on:
#     * ROLE   (this section)      -> WHICH resource types they may create
#     * POLICY (section 2)         -> HOW BIG/EXPENSIVE it may be
#
#   Turning the role on without the SKU-ceiling policies gives someone the
#   ability to deploy an F2048 Fabric capacity. Do not ship half of this.

ROLE_ENABLED=true
ROLE_NAME=AI Innovator (Cost-Bounded)
ROLE_DESCRIPTION=Deploy and operate AI workload resources. Cannot create compute, networking edge, or data platform resources with open-ended cost, and cannot grant itself access or alter cost controls.

# Where the role definition is created and assignable. Subscription is the
# normal answer; a management group makes it reusable across subscriptions.
# Format: subscription | /providers/Microsoft.Management/managementGroups/<id>
ROLE_ASSIGNABLE_SCOPE=subscription

# Resource providers the role may WRITE. Anything not listed here is denied by
# omission — that is the point. Additive; the script always includes `*/read`
# and the Foundry/Search/Cosmos/Fabric core below.
#
# Default set covers: Foundry + Foundry IQ (CognitiveServices + Search),
# Azure AI Search, Cosmos DB, Fabric, and the supporting resources a Foundry
# workload genuinely needs (storage, key vault, app config, container apps,
# ACR, monitoring, managed identity, private endpoints + private DNS).
ROLE_ALLOWED_PROVIDERS=Microsoft.CognitiveServices,Microsoft.MachineLearningServices,Microsoft.Search,Microsoft.DocumentDB,Microsoft.Fabric,Microsoft.Storage,Microsoft.KeyVault,Microsoft.AppConfiguration,Microsoft.App,Microsoft.ContainerRegistry,Microsoft.Insights,Microsoft.OperationalInsights,Microsoft.ManagedIdentity

# Extra providers to add without editing the line above. Comma separated.
ROLE_EXTRA_PROVIDERS=

# Principals to assign the role to once it exists. Object IDs (users, groups or
# service principals). Leave blank to create the definition without assigning —
# recommended for the first run so you can read the role before handing it out.
# A GROUP is strongly preferred over individual users.
ROLE_ASSIGN_PRINCIPAL_IDS=

# The role is only half a control, and half of it is worse than none because it
# looks finished. With this true (default) the script refuses to create the role
# unless the SKU ceilings are actually IN FORCE - the policy plane succeeded AND
# POLICY_EFFECT=Deny. Selecting the Policy plane is not enough: the two planes
# need different permissions, so the policy plane can fail while the role plane
# succeeds, leaving a live role and zero ceilings.
#
# With the default POLICY_EFFECT=Deny this never fires, which is the point - on
# the happy path it is silent. It exists to catch the other case: set it false
# ONLY when you have deliberately chosen POLICY_EFFECT=Audit to retrofit an
# existing subscription, accepting that the role is unbounded until you flip.
ROLE_REQUIRE_ENFORCING_CEILINGS=true


# -----------------------------------------------------------------------------
# 2. POLICY — the deployment gate and the SKU/capacity ceilings
# -----------------------------------------------------------------------------
# Azure Policy blocks DEPLOYMENT SHAPE. It never blocks CONSUMPTION. A fully
# compliant GPT deployment can still burn unlimited tokens — that is what the
# APIM token limit is for (section 4).

# Where NEW assignments land.
#   resourcegroup | subscription
#
# DEFAULT IS `subscription`, and it must stay aligned with ROLE_ASSIGNABLE_SCOPE
# (section 1). The role grants create rights across its assignable scope; if the
# ceilings evaluate a narrower scope, a role holder can create a new resource
# group and deploy into it with no ceiling in scope at all. The role also carries
# resourceGroups/write, so that is not hypothetical. The script REFUSES to create
# a subscription-scoped role against resource-group-scoped ceilings.
#
# KNOWN CONSEQUENCE, accept it deliberately: the landing-zone Bicep assigns some
# policies at resourcegroup scope, so subscription-scope assignments here will
# OVERLAP them inside that resource group. Overlap is evaluated, not merged -
# both assignments apply and the most restrictive effect wins. Expect duplicate
# compliance records for that resource group; expect no change in what is allowed.
POLICY_SCOPE=subscription

# Deny   -> enforcementMode=Default. Blocks non-compliant deployments. DEFAULT.
# Audit  -> enforcementMode=DoNotEnforce. Evaluates and reports, blocks nothing.
#
# THE DEFAULT IS `Deny`, and that is a deliberate reversal of the usual advice.
# A soak exists to discover which EXISTING workloads a new ceiling would break.
# This playbook runs against a landing zone that was just deployed, so there are
# no existing workloads to discover. Audit here would buy nothing and cost
# something: it produces a window with the custom role live and the ceilings
# inert, which is precisely the "looks finished but isn't" state the role/policy
# pairing exists to prevent.
#
# Choose `Audit` deliberately when RETROFITTING these ceilings onto a
# subscription that already has running workloads. That is the case a soak is
# for: assign in Audit, read the compliance results after at least one full 24h
# evaluation cycle, fix or exempt whatever the ceilings would have blocked, then
# flip to Deny. You will also need ROLE_REQUIRE_ENFORCING_CEILINGS=false for the
# duration, and the role is unbounded until you flip. Microsoft publishes no soak
# duration; decide yours from your own release rhythm, and write down the date
# you will flip.
#
# Why DoNotEnforce rather than the Audit effect: none of the tag built-ins
# expose an `effect` parameter — every one hardcodes `deny`. DoNotEnforce is
# the only observation mode that works across the whole pack. Flipping to Deny
# later is a one-property change; no re-authoring.
POLICY_EFFECT=Deny

# Subscription-scoped custom definitions get created here regardless of
# POLICY_SCOPE, because a resource-group-scoped definition cannot be authored.
POLICY_DEFINITION_SCOPE=subscription

# --- tagging / chargeback ---
# Tags to require and to inherit. The inherit-if-missing policies NEVER
# overwrite a tag that is already set.
REQUIRED_TAGS=environment,owner,costCenter

# --- location ---
# Both policies are assigned: resources AND resource groups. "Allowed
# locations" excludes resource groups, so you need the pair or you have a hole.
ALLOWED_LOCATIONS=eastus2,eastus

# --- resource-type deny-list (belt and braces behind the custom role) ---
# The role denies these by omission. This denies them again at the resource
# layer, so an unrelated Contributor grant doesn't reopen the door.
#
# Microsoft.KeyVault/managedHSMs is on this list on purpose, and it is the one
# entry the role does NOT already deny by omission: ROLE_ALLOWED_PROVIDERS
# includes Microsoft.KeyVault, which the role builder expands to
# `Microsoft.KeyVault/*` — so the role can create a Managed HSM. A Managed HSM
# is not a key vault with more features; it is dedicated single-tenant hardware
# billed per hour from the moment it is provisioned, whether or not a single
# key is ever used. This workload needs vaults, not an HSM. Denying the TYPE is
# simpler and stronger than authoring a SKU ceiling for it, and there is no
# meaningful "small" Managed HSM to allow.
DENIED_RESOURCE_TYPES=Microsoft.Compute/virtualMachineScaleSets,Microsoft.Compute/hostGroups,Microsoft.ContainerService/managedClusters,Microsoft.Databricks/workspaces,Microsoft.HDInsight/clusters,Microsoft.Kusto/clusters,Microsoft.Sql/managedInstances,Microsoft.Synapse/workspaces,Microsoft.AVS/privateClouds,Microsoft.NetApp/netAppAccounts,Microsoft.Network/expressRouteCircuits,Microsoft.Cache/redisEnterprise,Microsoft.PowerBIDedicated/capacities,Microsoft.DesktopVirtualization/hostPools,Microsoft.KeyVault/managedHSMs

# --- COST CEILINGS ---
# A custom definition where no built-in exists; the built-in where one does.
# Each custom definition in `policies/` records in its own header which
# built-ins were checked and why none of them was a substitute.

# Foundry model deployment capacity. Units are the SKU capacity integer, which
# for Standard-family deployments is thousands of TPM. 50 => 50,000 TPM.
# This is the gap their current template leaves open: it constrains the
# deployment SKU NAME but not the capacity, so an approved SKU can still be
# deployed at any size.
FOUNDRY_MAX_DEPLOYMENT_CAPACITY=50

# Deployment SKUs permitted. The Provisioned* families are deliberately absent:
# PTU bills hourly on deployed capacity regardless of use and billing only
# stops when the deployment is DELETED. That is a committed spend decision, not
# an innovation one. Add them only with an explicit approval.
FOUNDRY_ALLOWED_DEPLOYMENT_SKUS=GlobalStandard,DataZoneStandard,Standard

# Foundry account SKUs. S0 is the normal pay-per-token account tier.
FOUNDRY_ALLOWED_ACCOUNT_SKUS=S0,F0

# Deny accounts with dynamic quota enabled. Dynamic quota lets a Standard
# deployment exceed its TPM opportunistically and the overage is billed at
# normal rates — Microsoft documents that it has "no call enforcement of a
# ceiling". No default state is published, which is exactly why this is pinned
# declaratively rather than left to an undocumented default.
FOUNDRY_DENY_DYNAMIC_THROTTLING=true

# Azure AI Search. Cost is SKU x (replicas x partitions) = search units, so all
# three are capped. storage_optimized_* and standard3 are deliberately absent.
SEARCH_ALLOWED_SKUS=basic,standard
SEARCH_MAX_REPLICAS=2
SEARCH_MAX_PARTITIONS=2

# Microsoft Fabric capacity. F64 is the licence-threshold tier and a large
# step up in cost. An innovation sandbox does not need it.
FABRIC_ALLOWED_SKUS=F2,F4,F8

# Cosmos DB max provisioned RU/s per container. Uses the built-in policy
# "Azure Cosmos DB throughput should be limited" (parameter: throughputMax).
# Serverless accounts are unaffected.
COSMOS_MAX_THROUGHPUT_RU=4000

# Azure ML compute VM sizes. READ THIS ONE EVEN IF YOU SKIM THE REST.
#
# ROLE_ALLOWED_PROVIDERS includes Microsoft.MachineLearningServices, and the
# role builder expands every provider to `<provider>/*` — so the role grants
# workspaces/computes/write. That single operation creates a GPU cluster at any
# size. RBAC cannot see the vmSize in the request body, so this list is the
# only thing standing between an innovation sandbox and an ND96 cluster.
#
# The default is CPU-only and deliberately excludes EVERY GPU size — the whole
# NC, ND and NV series. That is not an oversight and it is not a starting point
# to be relaxed by whoever hits the wall first. A GPU node bills by the hour for
# as long as the cluster's minimum node count keeps it alive, which for a
# cluster left at minNodes>0 means it bills whether or not a job is running.
# Adding a GPU size here is a budget decision. Make it like one.
AML_ALLOWED_VM_SIZES=Standard_DS3_v2,Standard_DS11_v2,Standard_D4s_v3,Standard_E4s_v3

# Container registry SKU. ACR bills a flat daily rate per registry by tier, so
# the SKU is the entire cost decision. Premium is excluded by default.
#
# KNOWN TENSION, decide it deliberately: the only SKU-related ACR built-in
# ("Container registries should have SKUs that support Private Links") pushes
# registries UP to Premium, because Premium is the tier that supports private
# link. If this workload later requires a private-link registry, add Premium
# here with the cost accepted — do not drop the ceiling.
ACR_ALLOWED_SKUS=Basic,Standard

# Log Analytics daily-cap CEILING, enforced by policy across every workspace in
# scope. NOT the same setting as LOG_ANALYTICS_DAILY_CAP_GB in section 5: that
# one SETS the cap on the one workspace this script is pointed at; this one is
# the maximum any workspace is allowed to request.
#
# Keep this >= LOG_ANALYTICS_DAILY_CAP_GB, or the workspace the script caps in
# plane 4 will be non-compliant against the ceiling assigned in plane 1.
#
# WHY A CEILING AND NOT "DON'T RAISE THE CAP": Azure Policy is stateless. It
# evaluates the requested end state and never sees the previous value, so
# "must not be raised" is not expressible. The ceiling reaches the same outcome
# from the other direction — a raise past it is simply non-compliant.
#
# The rule catches all three bad states: no cap set at all, the -1 "unlimited"
# sentinel, and any value above this number. Log Analytics is billed per GB
# with no upper bound of its own, so an uncapped workspace is an open-ended
# bill and a new one is one `az` call away for anyone holding the role.
LOG_ANALYTICS_POLICY_MAX_DAILY_GB=50

# Container Apps scale ceiling. The role grants Microsoft.App/*, so both the
# managed environment and the apps inside it are in reach.
#
# Consumption is scale-to-zero and bills only on use. A DEDICATED workload
# profile is the opposite: it bills per provisioned node, by size, for as long
# as the profile exists, whether or not anything is running on it. The default
# list keeps Consumption plus the small end of the dedicated D-series; the GPU
# profiles and the large general-purpose and memory-optimised profiles are
# deliberately absent.
ACA_ALLOWED_WORKLOAD_PROFILE_TYPES=Consumption,D4,D8

# One number, two ceilings: the most nodes a dedicated workload profile may
# scale to, and the most replicas a single container app may scale to. They are
# different units but the same question — how many billed instances may this
# become — and they share a dial so the two cannot drift apart.
ACA_MAX_REPLICAS=10

# Storage account SKUs. Uses the built-in "Storage accounts should be limited
# by allowed SKUs" (7433c107-…, parameter: listOfAllowedSKUs) rather than a
# custom definition, because the built-in already does exactly this.
#
# The SKU is where replication cost is decided — GRS is roughly double LRS for
# the same bytes, and the Premium tiers are a different cost class again. The
# default covers local, zone and geo redundancy at the standard tier; Premium
# is excluded. Add a Premium SKU only if a workload genuinely needs premium
# blob or file performance, not because a template happened to ask for it.
STORAGE_ALLOWED_SKUS=Standard_LRS,Standard_ZRS,Standard_GRS

# --- approved models (Foundry) ---
# Built-in "Foundry model deployments should only use approved models".
# WARNING: if BOTH of these are left empty the policy rule matches EVERY
# deployment. The script refuses to assign it unless at least one is populated.
# Publishers are e.g. OpenAI, Microsoft, Meta. Asset IDs are fully-qualified
# model asset identifiers.
FOUNDRY_ALLOWED_PUBLISHERS=OpenAI,Microsoft
FOUNDRY_ALLOWED_ASSET_IDS=


# -----------------------------------------------------------------------------
# 3. FOUNDRY CONTROL PLANE
# -----------------------------------------------------------------------------
FOUNDRY_ACCOUNT_NAME=                                      # REQUIRED for plane 2

# Foundry quota tiers now rise automatically with usage, so a TPM ceiling set
# once can move on its own. Microsoft's own words: "Using quota to manage
# billing isn't the Azure best practice."
#
#   NoAutoUpgrade          -> pin the tier. The opt-out is a PREVIEW feature.
#   OnceUpgradeIsAvailable -> platform default; quota rises with usage.
#   skip                   -> make no change, and record that as a decision.
#
# Leaving this undecided is the worst option, because the team will believe
# quota is a budget when it is not. Pick one and write down why.
FOUNDRY_QUOTA_TIER_POLICY=NoAutoUpgrade

# GA api-version. 2025-10-01-preview also works but is preview; prefer GA for
# anything that runs unattended.
FOUNDRY_QUOTA_API_VERSION=2026-07-01


# -----------------------------------------------------------------------------
# 4. GATEWAY — verification only, the script never rewrites APIM policy
# -----------------------------------------------------------------------------
# The APIM token limit is the ONLY real-time hard stop on AI spend that exists
# here. Azure has no native spend cap:
#   "While OpenAI has an option for hard limits that prevent you from going
#    over your budget, Azure OpenAI doesn't currently provide this
#    functionality."  — Microsoft Learn
#
# APIM policy XML is owned by this repository's `modules/api-management/` and
# has no backup/restore on the v2 tiers, so source control is the only copy.
# This script therefore READS and asserts; it does not write. Failures here are
# reported as findings for you to fix in Bicep and redeploy.
#
# It also checks the ADR-004 controls: that streaming is refused (otherwise the
# token limit silently enforces on estimates), that the rate-limit backstop is
# present, and that callers carry readable billing labels.

APIM_NAME=                                                 # REQUIRED for plane 3
APIM_RESOURCE_GROUP=                                       # blank => AZ_RESOURCE_GROUP

# The `__OWNER__` token the gateway module substitutes. Used to locate the
# emergency-stop named value (`<owner>-stop`) and the owned API.
GATEWAY_OWNER=ailz-dev

# Cardinality budget check for `llm-emit-token-metric`.
# APIM caps each metric namespace at 1,000 active time series and each
# dimension at 100 unique values. Past either limit the data is SILENTLY
# DISCARDED - the dashboard just under-reports.
#
# The script reads the REAL caller set from the gateway's own
# `<owner>-configuration` named value, so these numbers are only a fallback for
# when that named value cannot be read. Note the arithmetic that matters here:
# because the gateway returns 403 before emitting a metric unless the caller
# matches exactly one configured mapping, and each mapping names exactly one
# project, active series is the SUM over callers of their approved model count -
# NOT the full cross-product. The binding constraint is the 100-unique-values
# per-dimension cap, which is what actually limits how many callers can be
# metered.
GATEWAY_METRIC_NAMESPACE=ailz-inference
GATEWAY_EXPECTED_PROJECTS=10
GATEWAY_EXPECTED_MODELS=5
GATEWAY_EXPECTED_CALLERS=6

# Retained for the fallback path only; one gateway serves one environment.
GATEWAY_EXPECTED_ENVIRONMENTS=1


# -----------------------------------------------------------------------------
# 5. LOGGING + COST MANAGEMENT
# -----------------------------------------------------------------------------
# Everything in this section is a smoke detector. None of it stops spend.
# Budgets alert 8-24h after the fact; anomaly detection runs ~36h after end of
# day. Useful, necessary, not a control.

LOG_ANALYTICS_WORKSPACE=                                   # REQUIRED for plane 4
LOG_ANALYTICS_RESOURCE_GROUP=                              # blank => AZ_RESOURCE_GROUP

# Daily cap is a CIRCUIT BREAKER, not a cost tool. Microsoft: it "should not be
# used as a primary mechanism to filter or reduce data", and when it fires
# "you are effectively blind to the current state of your monitored
# environment". Overshoot is still billed. Set it WELL ABOVE normal volume and
# treat hitting it as an incident.
# Minimum accepted by the platform is 0.023 GB. -1 means unlimited.
LOG_ANALYTICS_DAILY_CAP_GB=50

# Warning alert threshold, below the cap. Fires on the documented pre-cap
# signal (_LogOperation / Ingestion / OverQuota) so you hear about it before
# monitoring goes dark.
LOG_ANALYTICS_ENABLE_PRECAP_ALERT=true

# --- cost alert routing ---
# USE A DISTRIBUTION LIST, NOT A PERSON.
# Anomaly alerts are sent based on the rule creator's access at send time. If
# that person's access changes or they leave, the alerts silently stop. A DL
# does not fix the creator dependency, but it does stop the recipient side
# failing at the same time.
COST_ALERT_EMAILS=ai-platform-alerts@example.com           # REQUIRED for plane 4

# --- subscription budget ---
# A SUBSCRIPTION-SCOPE budget, created only if one does not already exist. This
# is NOT the budget the landing-zone Bicep owns: that one is resource-group
# scoped and this playbook only reads it. Two different objects, no conflict.
#
# Why subscription scope: the custom role and the SKU ceilings are both
# subscription-scoped, so spend can land in any resource group - including one a
# role holder creates tomorrow, which a resource-group budget can never see.
#
# CREATE-ONLY. If a budget of this name already exists it is reported and left
# untouched at whatever amount it has. Tuning a threshold by hand is a legitimate
# operator decision and reruns will not undo it.
#
# A BUDGET IS NOT A CAP. Microsoft: "Resources aren't affected, and your
# consumption isn't stopped." Cost data lags 8-24 hours and budgets evaluate
# about daily, so it alerts long after the money is gone. The only real-time hard
# stop in this architecture is the APIM token limit in plane 3.
#
# Notifications are created at 50/80/100% actual and 100% forecasted, routed to
# the action group below. Documented ceiling is five per budget; four leaves room.
SUBSCRIPTION_BUDGET_ENABLED=true

# Monthly amount in the subscription's billing currency. THE DEFAULT IS A
# PLACEHOLDER - set it deliberately. It is intentionally low rather than high: a
# budget that is too small produces a nuisance alert you will investigate, while
# one that is too large produces silence you will mistake for safety.
# Multi-currency subscriptions are not supported by budget evaluation, and a
# brand-new subscription can take up to 48 hours before a budget can be created.
SUBSCRIPTION_BUDGET_AMOUNT=1000

# Action group the script creates for cost alerts.
# NOTE: the landing-zone Bicep owns the BUDGET and its `contactGroups`. This
# script will NOT modify the budget. It creates the action group and prints the
# resource ID for you to paste into `governance.budget.contactGroups` in the
# environment JSON, so Bicep stays the single owner.
ACTION_GROUP_NAME=ag-ai-cost-alerts
ACTION_GROUP_SHORT_NAME=aicost                             # max 12 characters

# Cost anomaly alert. Subscription scope only, max 5 per subscription, and not
# available in Azure Government or sovereign clouds.
COST_ANOMALY_ALERT_ENABLED=true
COST_ANOMALY_ALERT_NAME=ai-cost-anomaly

# Saved Cost Analysis view at SUBSCRIPTION scope grouped by service.
# This exists to close a specific documented trap: costs for Azure Monitor /
# Log Analytics / Application Insights "aren't visible when scoped just to your
# Foundry resource". Scoping cost analysis to Foundry makes AI look cheap while
# logging accrues invisibly under another service.
COST_VIEW_ENABLED=true
COST_VIEW_NAME=ai-platform-total-cost

# Tag inheritance. Applies subscription and resource-group tags to child
# resource USAGE RECORDS (not to the resources). Retroactive to the 1st of the
# current month, ~8-24h to show up. Supported on EA, MCA and MPA with Azure plan.
#
# preferContainerTags=false  -> the RESOURCE tag wins on conflict (platform
#                               default; a deliberately-set tag is not
#                               overwritten by an inherited one)
# preferContainerTags=true   -> the highest scope wins
TAG_INHERITANCE_ENABLED=true
TAG_INHERITANCE_PREFER_CONTAINER_TAGS=false


# -----------------------------------------------------------------------------
# 6. RUN BEHAVIOUR
# -----------------------------------------------------------------------------
# Where the JSON evidence file is written. One per run, timestamped.
EVIDENCE_PATH=./evidence

# Set true to fail the whole run on the first error instead of collecting all
# findings. Leave false for the first few runs so you get the complete picture.
FAIL_FAST=false
